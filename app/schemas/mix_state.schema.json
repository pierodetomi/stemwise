{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MixState",
  "description": "The mix part of a project saved by a snapshot (HIS-4).",
  "type": "object",
  "properties": {
    "mix_bus": {
      "$ref": "#/$defs/MixBus"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Track"
      }
    }
  },
  "required": [
    "tracks",
    "mix_bus"
  ],
  "$defs": {
    "Author": {
      "type": "string",
      "enum": [
        "user",
        "ai"
      ]
    },
    "AutomationLane": {
      "type": "object",
      "properties": {
        "author": {
          "description": "Who last wrote the lane: the assistant (AUT-5) or the user (design D3).",
          "$ref": "#/$defs/Author"
        },
        "param": {
          "description": "Parameter id, see [`crate::params::ParamId`] (e.g. `fader`, `eq.1.gain`, `send.trk3`).",
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AutomationPoint"
          }
        },
        "visible": {
          "description": "Whether the lane is shown under the track (view state).",
          "type": "boolean"
        }
      },
      "required": [
        "param",
        "points",
        "author",
        "visible"
      ]
    },
    "AutomationPoint": {
      "type": "object",
      "properties": {
        "frame": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "frame",
        "value"
      ]
    },
    "BassEnhancer": {
      "description": "Bass enhancer (FX-18): harmonics of the low band, no octave below.",
      "type": "object",
      "properties": {
        "bypass": {
          "type": "boolean"
        },
        "freq_hz": {
          "type": "number",
          "format": "double"
        },
        "harmonics": {
          "type": "number",
          "format": "double"
        },
        "mix": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "bypass",
        "freq_hz",
        "harmonics",
        "mix"
      ]
    },
    "Chain": {
      "description": "FX-1, FX-10: trim → blocks in free order → fader → pan → sends. On a return the blocks follow its processor\n(FX-11) and the trim is not used.",
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FxBlock"
          }
        },
        "fader_db": {
          "type": "number",
          "format": "double"
        },
        "pan": {
          "type": "number",
          "format": "double"
        },
        "trim_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "trim_db",
        "blocks",
        "fader_db",
        "pan"
      ]
    },
    "Clip": {
      "type": "object",
      "properties": {
        "fade_in": {
          "$ref": "#/$defs/Fade"
        },
        "fade_out": {
          "$ref": "#/$defs/Fade"
        },
        "gain_db": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "media": {
          "type": "string"
        },
        "mute": {
          "type": "boolean"
        },
        "offset": {
          "description": "Offset into the media file of the clip's first frame.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start": {
          "description": "Timeline position of the clip's first frame.",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "media",
        "start",
        "offset",
        "length",
        "gain_db",
        "fade_in",
        "fade_out",
        "mute"
      ]
    },
    "Compressor": {
      "type": "object",
      "properties": {
        "attack_ms": {
          "type": "number",
          "format": "double"
        },
        "bypass": {
          "type": "boolean"
        },
        "knee_db": {
          "type": "number",
          "format": "double"
        },
        "makeup_db": {
          "type": "number",
          "format": "double"
        },
        "mix": {
          "description": "Dry/wet, 0..1: below 1 the uncompressed signal is blended back in (parallel compression, FX-3). Tracks\nand groups only: the master compressor keeps it at 1.",
          "type": "number",
          "format": "double"
        },
        "ratio": {
          "type": "number",
          "format": "double"
        },
        "release_ms": {
          "type": "number",
          "format": "double"
        },
        "sidechain": {
          "description": "Detector input from another track or group, post-fader (FX-3).",
          "anyOf": [
            {
              "$ref": "#/$defs/Sidechain"
            },
            {
              "type": "null"
            }
          ]
        },
        "threshold_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "bypass",
        "threshold_db",
        "ratio",
        "attack_ms",
        "release_ms",
        "knee_db",
        "makeup_db",
        "mix"
      ]
    },
    "Deesser": {
      "description": "De-esser (FX-14).",
      "type": "object",
      "properties": {
        "bypass": {
          "type": "boolean"
        },
        "freq_hz": {
          "type": "number",
          "format": "double"
        },
        "max_reduction_db": {
          "type": "number",
          "format": "double"
        },
        "mode": {
          "$ref": "#/$defs/DeesserMode"
        },
        "threshold_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "bypass",
        "freq_hz",
        "threshold_db",
        "max_reduction_db",
        "mode"
      ]
    },
    "DeesserMode": {
      "oneOf": [
        {
          "description": "Only what is above the frequency goes down.",
          "type": "string",
          "const": "split"
        },
        {
          "description": "The whole signal goes down.",
          "type": "string",
          "const": "wide"
        }
      ]
    },
    "DelayCharacter": {
      "type": "string",
      "enum": [
        "clean",
        "tape"
      ]
    },
    "DelayMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "stereo"
          ]
        },
        {
          "description": "The input summed to mono, repeats alternating left and right.",
          "type": "string",
          "const": "ping_pong"
        }
      ]
    },
    "DeqBand": {
      "type": "object",
      "properties": {
        "attack_ms": {
          "type": "number",
          "format": "double"
        },
        "enabled": {
          "type": "boolean"
        },
        "freq_hz": {
          "type": "number",
          "format": "double"
        },
        "kind": {
          "$ref": "#/$defs/EqKind"
        },
        "q": {
          "type": "number",
          "format": "double"
        },
        "range_db": {
          "description": "Most gain the band takes, −12 … +6 dB: negative cuts, positive lifts.",
          "type": "number",
          "format": "double"
        },
        "release_ms": {
          "type": "number",
          "format": "double"
        },
        "sidechain": {
          "description": "The detector hears the same band of another track or group (FX-3).",
          "type": [
            "string",
            "null"
          ]
        },
        "threshold_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "enabled",
        "kind",
        "freq_hz",
        "q",
        "threshold_db",
        "range_db",
        "attack_ms",
        "release_ms"
      ]
    },
    "Doubler": {
      "description": "Doubler (FX-21): voices slightly out of tune and slowly moving in time, inside the track.",
      "type": "object",
      "properties": {
        "bypass": {
          "type": "boolean"
        },
        "delay_ms": {
          "type": "number",
          "format": "double"
        },
        "detune_cents": {
          "type": "number",
          "format": "double"
        },
        "mix": {
          "type": "number",
          "format": "double"
        },
        "spread": {
          "type": "number",
          "format": "double"
        },
        "voices": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "bypass",
        "voices",
        "detune_cents",
        "delay_ms",
        "spread",
        "mix"
      ]
    },
    "DynamicEq": {
      "description": "Dynamic EQ (FX-15): one or two bands that move only when their detector passes the threshold.",
      "type": "object",
      "properties": {
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeqBand"
          }
        },
        "bypass": {
          "type": "boolean"
        }
      },
      "required": [
        "bypass",
        "bands"
      ]
    },
    "EqBand": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "freq_hz": {
          "type": "number",
          "format": "double"
        },
        "gain_db": {
          "type": "number",
          "format": "double"
        },
        "kind": {
          "$ref": "#/$defs/EqKind"
        },
        "q": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "enabled",
        "kind",
        "freq_hz",
        "gain_db",
        "q"
      ]
    },
    "EqKind": {
      "type": "string",
      "enum": [
        "peak",
        "low_shelf",
        "high_shelf"
      ]
    },
    "Equalizer": {
      "type": "object",
      "properties": {
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EqBand"
          }
        },
        "bypass": {
          "type": "boolean"
        }
      },
      "required": [
        "bypass",
        "bands"
      ]
    },
    "Exciter": {
      "description": "Exciter (FX-18).",
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "format": "double"
        },
        "bypass": {
          "type": "boolean"
        },
        "drive_db": {
          "type": "number",
          "format": "double"
        },
        "freq_hz": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "bypass",
        "freq_hz",
        "drive_db",
        "amount"
      ]
    },
    "Fade": {
      "type": "object",
      "properties": {
        "length": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "shape": {
          "$ref": "#/$defs/FadeShape"
        }
      },
      "required": [
        "length",
        "shape"
      ]
    },
    "FadeShape": {
      "type": "string",
      "enum": [
        "linear",
        "equal_power"
      ]
    },
    "Filter": {
      "description": "High-pass or low-pass (FX-1, FX-12): 12 dB/octave, with a resonance.",
      "type": "object",
      "properties": {
        "bypass": {
          "type": "boolean"
        },
        "freq_hz": {
          "type": "number",
          "format": "double"
        },
        "resonance": {
          "description": "Q of the filter, 0.5 … 10; 0.707 is the flat Butterworth response of schema 3 (FX-12).",
          "type": "number",
          "format": "double",
          "default": 0.7071067811865476
        }
      },
      "required": [
        "bypass",
        "freq_hz"
      ]
    },
    "Fx": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hpf"
            }
          },
          "$ref": "#/$defs/Filter",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "lpf"
            }
          },
          "$ref": "#/$defs/Filter",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "eq"
            }
          },
          "$ref": "#/$defs/Equalizer",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "compressor"
            }
          },
          "$ref": "#/$defs/Compressor",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "saturation"
            }
          },
          "$ref": "#/$defs/Saturation",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gate"
            }
          },
          "$ref": "#/$defs/Gate",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "deesser"
            }
          },
          "$ref": "#/$defs/Deesser",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dynamic_eq"
            }
          },
          "$ref": "#/$defs/DynamicEq",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "transient"
            }
          },
          "$ref": "#/$defs/Transient",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "clipper"
            }
          },
          "$ref": "#/$defs/TrackClipper",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "multiband"
            }
          },
          "$ref": "#/$defs/Multiband",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "exciter"
            }
          },
          "$ref": "#/$defs/Exciter",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bass_enhancer"
            }
          },
          "$ref": "#/$defs/BassEnhancer",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "width"
            }
          },
          "$ref": "#/$defs/StereoWidth",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "modulation"
            }
          },
          "$ref": "#/$defs/Modulation",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tremolo"
            }
          },
          "$ref": "#/$defs/Tremolo",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "harmonizer"
            }
          },
          "$ref": "#/$defs/Harmonizer",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "doubler"
            }
          },
          "$ref": "#/$defs/Doubler",
          "required": [
            "type"
          ]
        }
      ]
    },
    "FxBlock": {
      "type": "object",
      "properties": {
        "fx": {
          "$ref": "#/$defs/Fx"
        },
        "id": {
          "description": "`<kind key>` or `<kind key><n>` (`eq`, `eq2`): unique in the chain, stable when the block moves.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fx"
      ]
    },
    "Gate": {
      "description": "Gate and expander (FX-13).",
      "type": "object",
      "properties": {
        "attack_ms": {
          "type": "number",
          "format": "double"
        },
        "bypass": {
          "type": "boolean"
        },
        "detector_hpf_hz": {
          "type": "number",
          "format": "double"
        },
        "detector_lpf_hz": {
          "type": "number",
          "format": "double"
        },
        "hold_ms": {
          "type": "number",
          "format": "double"
        },
        "range_db": {
          "description": "How far the signal goes down below the threshold.",
          "type": "number",
          "format": "double"
        },
        "ratio": {
          "description": "1 … 20: at 20 it is a gate, below an expander.",
          "type": "number",
          "format": "double"
        },
        "release_ms": {
          "type": "number",
          "format": "double"
        },
        "sidechain": {
          "type": [
            "string",
            "null"
          ]
        },
        "threshold_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "bypass",
        "threshold_db",
        "range_db",
        "ratio",
        "attack_ms",
        "hold_ms",
        "release_ms",
        "detector_hpf_hz",
        "detector_lpf_hz"
      ]
    },
    "HarmVoice": {
      "type": "object",
      "properties": {
        "cents": {
          "type": "number",
          "format": "double"
        },
        "enabled": {
          "type": "boolean"
        },
        "level_db": {
          "type": "number",
          "format": "double"
        },
        "pan": {
          "type": "number",
          "format": "double"
        },
        "semitones": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "enabled",
        "semitones",
        "cents",
        "level_db",
        "pan"
      ]
    },
    "Harmonizer": {
      "description": "Harmonizer (FX-21).",
      "type": "object",
      "properties": {
        "bypass": {
          "type": "boolean"
        },
        "mix": {
          "type": "number",
          "format": "double"
        },
        "voices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HarmVoice"
          }
        }
      },
      "required": [
        "bypass",
        "voices",
        "mix"
      ]
    },
    "LfoShape": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "sine",
            "triangle"
          ]
        },
        {
          "description": "A square with rounded edges.",
          "type": "string",
          "const": "square"
        }
      ]
    },
    "MbBand": {
      "type": "object",
      "properties": {
        "attack_ms": {
          "type": "number",
          "format": "double"
        },
        "bypass": {
          "type": "boolean"
        },
        "gain_db": {
          "description": "Level of the band after its compressor.",
          "type": "number",
          "format": "double"
        },
        "ratio": {
          "type": "number",
          "format": "double"
        },
        "release_ms": {
          "type": "number",
          "format": "double"
        },
        "threshold_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "bypass",
        "threshold_db",
        "ratio",
        "attack_ms",
        "release_ms",
        "gain_db"
      ]
    },
    "MixBus": {
      "type": "object",
      "properties": {
        "fader_db": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "fader_db"
      ]
    },
    "ModMode": {
      "type": "string",
      "enum": [
        "chorus",
        "flanger",
        "phaser"
      ]
    },
    "Modulation": {
      "description": "Modulation (FX-20).",
      "type": "object",
      "properties": {
        "bypass": {
          "type": "boolean"
        },
        "depth": {
          "type": "number",
          "format": "double"
        },
        "feedback": {
          "type": "number",
          "format": "double"
        },
        "mix": {
          "type": "number",
          "format": "double"
        },
        "mode": {
          "$ref": "#/$defs/ModMode"
        },
        "rate_hz": {
          "type": "number",
          "format": "double"
        },
        "spread_deg": {
          "type": "number",
          "format": "double"
        },
        "stages": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "sync": {
          "description": "Musical value (\"1/4\", \"1/8.\") that sets the rate from the tempo, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "voices": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "bypass",
        "mode",
        "rate_hz",
        "depth",
        "feedback",
        "voices",
        "stages",
        "spread_deg",
        "mix"
      ]
    },
    "Multiband": {
      "description": "Multiband compressor (MAS-12): two to six bands split by `crossovers_hz` (ascending, one fewer than the bands).",
      "type": "object",
      "properties": {
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MbBand"
          }
        },
        "bypass": {
          "type": "boolean"
        },
        "crossovers_hz": {
          "type": "array",
          "items": {
