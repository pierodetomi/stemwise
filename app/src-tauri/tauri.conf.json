{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stemwise",
  "version": "0.1.1",
  "identifier": "app.stemwise.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ui exec vite --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stemwise",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "backgroundColor": "#1b1420"
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "copyright": "Copyright © 2026 Piero De Tomi. MIT licence.",
    "license": "MIT",
    "resources": { "../../LICENSE": "LICENSE", "resources/THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
