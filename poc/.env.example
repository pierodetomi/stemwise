# Copy to .env (never committed). Used only by the real LLM decider and `make test-llm`.
OPENROUTER_API_KEY=

# --- Decider (M3, D-037, D-045). Copy to .env and fill in; .env is never committed. ---
# Model id on OpenRouter (required with --decider llm; no default in the code).
# Candidates under comparison (Q-2): openai/gpt-6.1-terra, openai/gpt-6.1-sol,
# anthropic/claude-haiku-5.5. The default is fixed after the comparison of M3.
STEMWISE_MODEL=openai/gpt-6.1-sol
# Reasoning effort, if the model supports it: low, medium, high, xhigh (empty = provider default).
STEMWISE_REASONING_EFFORT=medium
# Sampling temperature (default 0.2); sent only to models that accept it.
STEMWISE_TEMPERATURE=0.2
# OpenAI-compatible endpoint (default OpenRouter).
STEMWISE_BASE_URL=https://openrouter.ai/api/v1
