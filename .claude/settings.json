{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make setup)",
      "Bash(make reqs:*)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run stemwise:*)",
      "Bash(uv run python scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch -c:*)",
      "Bash(git switch product/v1)",
      "Bash(git tag:*)",
      "Bash(make:*)",
      "Bash(cargo:*)",
      "Bash(rustup component add:*)",
      "Bash(rustup target add:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(uv run:*)",
      "Bash(du:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(make test-llm)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_python.sh"
          }
        ]
      }
    ]
  }
}
